<Project Sdk="Microsoft.NET.Sdk">

  <!-- A program the Rust crate skakel-server runs in its tests: the .NET client, the one the .NET server's
       own tests use, driven against a Rust server on loopback. The Rust test starts the server, runs one
       scenario of this program and reads what it prints. Not a test project: nothing in `dotnet test`
       runs it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Skakel.Client\Skakel.Client.csproj" />
  </ItemGroup>

</Project>
