<Project Sdk="Microsoft.NET.Sdk">

  <!-- A tiny program the Rust crate skakel-discovery runs in its tests, to check that a Rust probe finds
       a .NET answer and a .NET probe finds a Rust answer. Loopback only. Not a test project: nothing in
       `dotnet test` runs it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Skakel.Protocol\Skakel.Protocol.csproj" />
    <ProjectReference Include="..\..\src\Skakel.Discovery\Skakel.Discovery.csproj" />
  </ItemGroup>

</Project>
