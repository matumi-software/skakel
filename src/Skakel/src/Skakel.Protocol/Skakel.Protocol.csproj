       part and none on ASP.NET, so a client of any kind can use it. -->
  <PropertyGroup>
    <Description>The Skakel protocol: wire constants, paths, certificate fingerprints and the JSON contract shared by Skakel clients and servers.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Skakel.Protocol.Tests" />
  </ItemGroup>

</Project>
