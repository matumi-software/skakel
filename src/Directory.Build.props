<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- packages.lock.json beside every project, committed. Restore with -p:RestoreLockedMode=true in a
         release build, so it fails instead of picking up a different package. Regenerate with
         `dotnet restore` after changing a package version. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Release builds map source paths to /_/, so the packages carry no local paths and the same
         commit builds the same DLLs wherever it is checked out. -->
    <ContinuousIntegrationBuild Condition="'$(Configuration)' == 'Release'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- What every package says about itself. Test projects set IsPackable to false. -->
  <PropertyGroup>
    <Version>0.2.0</Version>
    <Authors>Matumi Software</Authors>
    <Company>Matumi Software</Company>
    <Copyright>Copyright (c) 2026 Matumi Software</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/matumi-software/skakel</PackageProjectUrl>
    <RepositoryUrl>https://github.com/matumi-software/skakel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <!-- The PDB goes inside the DLL, so stepping into Skakel works without a symbol server. -->
    <DebugType>embedded</DebugType>
    <PackageTags>lan;discovery;pairing;oauth;signalr;websocket</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../resources/design-system/assets/Logos/skakel-app-icon-128.png" Pack="true" PackagePath="/icon.png" Visible="false" />
  </ItemGroup>
</Project>
